# =============================================================================
# CONFIGURACIÓN DE SUPABASE Y DESPLIEGUE (PLANTILLA DE EJEMPLO)
# =============================================================================
# Copia este archivo como ".env" en la raíz del proyecto y completa los valores
# obtenidos desde tu panel de Supabase -> Project Settings -> API.
#
# IMPORTANTE DE SEGURIDAD:
# - Utiliza únicamente la clave pública (anon / public key).
# - NUNCA incluyas la clave secreta "service_role" en el frontend ni en GitHub.
# - La seguridad de los datos está protegida mediante políticas RLS en PostgreSQL.

VITE_SUPABASE_URL=https://tu-proyecto-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_clave_publica_anon_aqui

# Ruta base opcional para GitHub Pages (por defecto './' funciona automáticamente
# en cualquier repositorio, o puedes indicar '/nombre-de-tu-repositorio/')
VITE_BASE_PATH=./
